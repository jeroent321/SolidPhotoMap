{
  "name": "solidphotomap",
  "type": "module",
  "private": true,
  "solidrt": {
    "appId": "local.jeroen.solidphotomap",
    "displayName": "Photo Map",
    "icon": null,
    "iconBackground": "#0f1115",
    "capabilities": {
      "camera": false,
      "microphone": false,
      "vibration": false,
      "internet": true
    },
    "backup": false,
    "android": {
      "versionCode": null,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "fonts": {
      "sans": true,
      "serif": false,
      "mono": false
    }
  },
  "scripts": {
    "dev": "srt run",
    "pack": "srt pack",
    "android": "srt android",
    "apk": "srt pack --apk",
    "phone": "SOLIDPHOTOMAP_PHONE=1 srt client -c 3 --size 412x892"
  },
  "dependencies": {
    "@solidrt/core": "0.0.63"
  },
  "devDependencies": {
    "@solidrt/android-arm64-v8a": "0.0.63",
    "@solidrt/cli": "0.0.63",
    "@solidrt/flux-types": "0.0.63",
    "typescript": "^7"
  }
}
